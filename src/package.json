{
  "name": "iteag-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ./assets/css/production.css -o ./static/css/main.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./assets/css/production.css -o ./static/css/main.css --watch",
    "vendor:build": "node scripts/copier-vendor.mjs",
    "build": "npm run vendor:build && npm run css:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  }
}
