# ITEAG Platform — Environment variables
# Copy this file to .env and adjust values.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3

WAGTAILADMIN_BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=secretariat@iteag.org
SITE_URL=http://localhost:8000

# Boutique
COMMERCE_FRAIS_LIVRAISON=0.00
COMMERCE_ALERTE_EMAIL=secretariat@example.com

# ── Paiement en ligne (Stripe) ─────────────────────────────────
# Clés du tableau de bord Stripe. En développement, utiliser les clés de test
# (« sk_test_… ») : aucune carte réelle n'est débitée.
STRIPE_CLE_PUBLIABLE=pk_test_change-me
STRIPE_CLE_SECRETE=sk_test_change-me
# Secret de signature du point d'entrée webhook (« whsec_… »). Sans lui, une
# notification de paiement forgée serait acceptée : le paiement n'est donc
# jamais pris en compte tant qu'il est vide.
#   stripe listen --forward-to localhost:8000/paiements/stripe/webhook/
STRIPE_SECRET_WEBHOOK=whsec_change-me
STRIPE_DEVISE=EUR
# Taux proposé par défaut dans les formulaires de tarification, en pourcentage.
# 0 si l'ITEAG relève de l'exonération de formation professionnelle.
PAIEMENTS_TAUX_TVA_DEFAUT=0.00

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Diffusion vidéo (ADR-005) ──────────────────────────────────
# Fournisseur des modules protégés : Bunny Stream, sans stockage vidéo chez nous.
ELEARNING_DIFFUSION_VIDEO=bunny
ELEARNING_DIFFUSION_PUBLIQUE=youtube,vimeo
BUNNY_ZONE_DIFFUSION=https://vz-xxxxxxxx.b-cdn.net
# Clé « URL Token Authentication Key » de la Pull Zone liée à Bunny Stream.
# Ne pas utiliser la clé API Stream ni la clé de protection du lecteur intégré.
BUNNY_CLE_SIGNATURE=change-me
BUNNY_LIER_ADRESSE_IP=False

# Production Docker : utiliser ces valeurs dans le .env du serveur.
# POSTGRES_DB=iteag
# POSTGRES_USER=iteag
# POSTGRES_PASSWORD=change-me-long-et-aleatoire
# DATABASE_URL=postgres://iteag:mot-de-passe-encode@db:5432/iteag
# REDIS_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# DJANGO_ALLOWED_HOSTS=iteag.org,www.iteag.org
