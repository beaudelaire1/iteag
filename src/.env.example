# ITEAG Platform — Environment variables
# Copy this file to .env and adjust values.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3

WAGTAILADMIN_BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=secretariat@iteag.org

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Diffusion vidéo (ADR-005) ──────────────────────────────────
# Fournisseur des modules protégés : local | s3 | bunny
# "bunny" en production : adresse HLS signée, révocable, sans stockage chez nous.
ELEARNING_DIFFUSION_VIDEO=local

# Fournisseurs admis pour le contenu public (bandes-annonces du catalogue).
# Ils ne protègent rien : le modèle refuse de les rattacher à un module restreint.
ELEARNING_DIFFUSION_PUBLIQUE=youtube

# Zone de diffusion Bunny, avec le protocole et sans barre finale.
BUNNY_ZONE_DIFFUSION=
# Clé de signature des jetons. Ne quitte jamais le serveur ; ne jamais la
# transmettre au navigateur ni la journaliser.
BUNNY_CLE_SIGNATURE=
# Lier le jeton à l'adresse IP du demandeur : plus strict, mais coupe la
# lecture quand l'adresse change en cours de séance (fréquent en mobile).
BUNNY_LIER_ADRESSE_IP=False
