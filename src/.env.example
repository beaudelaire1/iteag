# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_DEBUG_TOOLBAR=False
DJANGO_BROWSER_RELOAD=False

# Base de données
DATABASE_URL=sqlite:///db.sqlite3

# Wagtail
WAGTAILADMIN_BASE_URL=http://localhost:8000

# E-mail et URL du site
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=secretariat@iteag.org
SERVER_EMAIL=errors@iteag.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TEST_RECIPIENT=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
SITE_URL=http://localhost:8000

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_TIMEOUT=5

# Stockage Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=iteag-media
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_EXPIRE=3600

# Boutique
COMMERCE_SEUIL_LIVRAISON_OFFERTE=150.00
COMMERCE_ALERTE_EMAIL=secretariat@example.com

# Paiements Stripe
STRIPE_CLE_PUBLIABLE=pk_test_change-me
STRIPE_CLE_SECRETE=sk_test_change-me
STRIPE_SECRET_WEBHOOK=whsec_change-me
STRIPE_DEVISE=EUR
PAIEMENTS_TAUX_TVA_DEFAUT=0.00

# Tâches Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True

# Sentry
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=False
SENTRY_ENABLE_LOGS=True
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
SENTRY_PROFILE_LIFECYCLE=trace

# E-learning et vidéo
ELEARNING_DIFFUSION_VIDEO=bunny
ELEARNING_DIFFUSION_PUBLIQUE=youtube,vimeo
BUNNY_ZONE_DIFFUSION=https://vz-xxxxxxxx.b-cdn.net
BUNNY_CLE_SIGNATURE=change-me
BUNNY_LIER_ADRESSE_IP=False
