# ═══════════════════════════════════════════════════════════════
# ITEAG — Variables de production (OVH Cloud, console Coolify)
# ═══════════════════════════════════════════════════════════════
# Ce fichier est une LISTE DE CONTRÔLE : il ne contient aucune valeur secrète.
# Les valeurs se saisissent dans Coolify, qui les dépose en « .env » à
# côté du fichier Compose. Ne JAMAIS commiter un « .env » rempli.
#
# La stack de production refuse désormais les replis silencieux : SMTP,
# Turnstile, R2, Sentry, Bunny, identité de révision et sauvegarde hors
# serveur doivent être configurés avant l'ouverture publique.
#
# DATABASE_URL, REDIS_URL et les URL Celery ne figurent pas ici : le
# fichier docker-compose.prod.yml les compose à partir des POSTGRES_*.
#
# Procédure complète : docs/exploitation/coolify.md
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=iteag
POSTGRES_USER=iteag
POSTGRES_PASSWORD=              # ⚠️ OBLIGATOIRE — Générer un mot de passe robuste

# ── Sauvegardes PostgreSQL hors serveur (Cloudflare R2) ──
# Une production ouverte au public doit laisser BACKUP_ENABLED=true.
# Le premier dump est lancé après les migrations au démarrage du service.
BACKUP_ENABLED=true
BACKUP_R2_ENDPOINT_URL=          # ⚠️ OBLIGATOIRE
BACKUP_R2_ACCESS_KEY_ID=         # ⚠️ OBLIGATOIRE — clé dédiée aux sauvegardes
BACKUP_R2_SECRET_ACCESS_KEY=     # ⚠️ OBLIGATOIRE
BACKUP_R2_BUCKET=iteag-bucket
BACKUP_R2_REGION=auto
BACKUP_R2_PREFIX=postgres
# Sauvegarde quotidienne à 03:00 heure de Guyane + une sauvegarde au démarrage.
BACKUP_TIMEZONE=America/Cayenne
BACKUP_HOUR_LOCAL=3
BACKUP_MINUTE_LOCAL=0
BACKUP_RUN_ON_START=true
BACKUP_RETRY_SECONDS=3600
# 35 sauvegardes quotidiennes environ et 12 mensuelles environ.
BACKUP_RETENTION_DAYS=35
BACKUP_MONTHLY_RETENTION_DAYS=400

# ── Django ──
DJANGO_SECRET_KEY=              # ⚠️ OBLIGATOIRE — python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=iteag.org,www.iteag.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://iteag.org,https://www.iteag.org
# Rafraîchit l'expiration glissante d'une session active toutes les 5 minutes,
# sans réécrire PostgreSQL à chaque requête.
SESSION_REFRESH_INTERVAL=300

# ── Identité du déploiement Coolify ──
# ⚠️ OBLIGATOIRE — dans Coolify, créer ITEAG_REVISION avec EXACTEMENT la valeur
# $SOURCE_COMMIT (sans remplacer manuellement par un SHA). SOURCE_COMMIT est la
# variable prédéfinie Coolify ; ITEAG_REVISION évite de la redéclarer/masquer.
# Chaque déploiement reçoit ainsi automatiquement son propre SHA Git.
ITEAG_REVISION=$SOURCE_COMMIT

# ── Sonde de santé ──
# Facultatif. Vide, /healthz publie son détail par dépendance à qui la
# consulte : deux booléens, position assumée. Renseigné, le code de réponse
# reste public — la supervision et le HEALTHCHECK du conteneur en vivent —
# mais le détail exige l'en-tête « X-Healthz-Token ».
HEALTHZ_JETON=

# ── Durées de conservation ──
# Arbitrées au §3 bis de docs/conformite/registre_traitements.md. Les défauts
# du code appliquent déjà ces valeurs : ne les surcharger ici que si l'ITEAG
# révise sa décision — et corriger alors le registre, faute de quoi la CI
# refuse la divergence.
# RETENTION_JOURNAL_AUDIT_JOURS=365
# RETENTION_JOURNAL_ACCES_VIDEO_JOURS=90

# ── URL du site ──
# SITE_URL doit désigner l'hôte réellement servi au public : il alimente la
# balise canonique, les URL du sitemap et celles des courriels.
SITE_URL=https://iteag.org
WAGTAILADMIN_BASE_URL=https://iteag.org

# ── Mentions légales ──
# Publiées sur /mentions-legales/ et /conditions-generales-de-vente/. Seul
# l'ITEAG connaît ces valeurs ; « verifier_production » refuse de valider une
# instance dont l'une d'elles manque.
# ⚠️ Les valeurs pré-remplies ci-dessous sont SOURCÉES, PAS VÉRIFIÉES par
# l'ITEAG. Chacune porte sa source. À relire avant la bascule.
#
# Relevée sur iteag.org, page « L'institut » : « La forme — Une association
# loi 1905 » ; même mention dans l'archive du site de juillet 2023. Ce n'est
# donc pas une association loi 1901. À noter : le registre INSEE classe
# l'association en catégorie 9220 « Association déclarée », sans mentionner la
# loi de 1905. Trancher d'après les statuts.
ITEAG_FORME_JURIDIQUE=Association régie par la loi du 9 décembre 1905
# Annuaire des entreprises (INSEE + RNA), recherche « ITEAG » : correspondance
# unique, « INSTITUT DE THEOLOGIE EVANGELIQUE DES ANTILLES ET DE LA GUYANE —
# ITEAG », siège « 201 LOTISSEMENT POINTE D'OR 97139 LES ABYMES » — la même
# adresse que celle du site. Association active, créée le 14 novembre 2016.
ITEAG_IMMATRICULATION=RNA W9G2004341 — SIRET 829 562 529 00018
# Gouvernance indiquée par la maîtrise d'ouvrage : Jean-Claude Girondin,
# président, et Alain Nisus, directeur pédagogique. Aucune source publique ne
# les donnait — ni le site, ni son archive, ni le registre, qui ne liste aucun
# dirigeant.
#
# C'est le président qui figure ici : au sens de la LCEN (art. 6-III-1), le
# directeur de la publication d'une personne morale est son représentant légal.
# La direction pédagogique est un rôle interne, sans effet sur cette
# responsabilité. Si l'association a formellement désigné quelqu'un d'autre à
# cette fonction, c'est ce nom-là qu'il faut mettre.
ITEAG_DIRECTEUR_PUBLICATION=Jean-Claude Girondin
ITEAG_HEBERGEUR=OVH SAS           # d'après docs/exploitation/coolify.md — à confirmer
ITEAG_HEBERGEUR_ADRESSE=2 rue Kellermann, 59100 Roubaix, France
# ⚠️ OBLIGATOIRE — ET NON RENSEIGNABLE DEPUIS UNE SOURCE PUBLIQUE.
# Un médiateur n'existe qu'une fois l'adhésion souscrite. Y inscrire un nom
# Facultatif : numéro de déclaration d'activité de formation, s'il existe.
ITEAG_NUMERO_DECLARATION_ACTIVITE=
# Dates de version affichées en tête des deux documents.
ITEAG_MENTIONS_VERSION=9 août 2026
ITEAG_CGV_VERSION=9 août 2026

# ── E-mail SMTP ──
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=secretariat@iteag.org
SERVER_EMAIL=errors@iteag.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=               # ⚠️ OBLIGATOIRE
EMAIL_HOST_PASSWORD=           # ⚠️ OBLIGATOIRE
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_TEST_RECIPIENT=

# ── Cloudflare Turnstile ──
CLOUDFLARE_TURNSTILE_ENABLED=True
CLOUDFLARE_TURNSTILE_SITE_KEY=   # ⚠️ OBLIGATOIRE
CLOUDFLARE_TURNSTILE_SECRET_KEY= # ⚠️ OBLIGATOIRE
CLOUDFLARE_TURNSTILE_TIMEOUT=5

# ── Stockage Cloudflare R2 ──
AWS_ACCESS_KEY_ID=               # ⚠️ OBLIGATOIRE
AWS_SECRET_ACCESS_KEY=           # ⚠️ OBLIGATOIRE
AWS_STORAGE_BUCKET_NAME=iteag-media
AWS_S3_ENDPOINT_URL=             # ⚠️ OBLIGATOIRE — https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_EXPIRE=3600
# Domaine personnalisé R2. Fortement recommandé : sans lui, l'origine des
# médias injectée dans la CSP est l'URL brute du bucket, qui publie
# l'identifiant du compte Cloudflare dans chaque réponse HTTP.
AWS_S3_CUSTOM_DOMAIN=

# ── Celery ──
# Les URL Redis sont injectées automatiquement par docker-compose.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_CONCURRENCY=2

# ── Sentry ──
SENTRY_DSN=                     # ⚠️ OBLIGATOIRE
SENTRY_SEND_DEFAULT_PII=False
SENTRY_ENABLE_LOGS=True
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
SENTRY_PROFILE_LIFECYCLE=trace

# ── E-learning et vidéo ──
ELEARNING_DIFFUSION_VIDEO=bunny
ELEARNING_DIFFUSION_PUBLIQUE=youtube,vimeo
BUNNY_ZONE_DIFFUSION=            # ⚠️ OBLIGATOIRE
# Pull Zone > Security > « URL Token Authentication Key ». Elle signe la LECTURE.
BUNNY_CLE_SIGNATURE=             # ⚠️ OBLIGATOIRE
BUNNY_LIER_ADRESSE_IP=False
# Requis pour le dépôt d'une vidéo depuis la plateforme, les chapitres et les
# aperçus du lecteur. La clé n'est utilisée que côté serveur.
#
# ATTENTION — deux clés Bunny, deux endroits, deux usages. Celle-ci se prend
# dans Stream > bibliothèque > API > « API Key » et autorise le DÉPÔT. Y coller
# la clé de signature ci-dessus fait répondre 401 à tout téléversement, sans
# rien casser à la lecture : la panne ne se voit que le jour d'un dépôt.
# `python manage.py verifier_bunny` (sans argument) tranche en une seconde.
BUNNY_STREAM_LIBRARY_ID=         # ⚠️ OBLIGATOIRE — identifiant numérique de la bibliothèque Stream
BUNNY_STREAM_API_KEY=            # ⚠️ OBLIGATOIRE — « API Key » de la bibliothèque Stream

# ── Gunicorn ──
WEB_CONCURRENCY=3
PORT=8000

# ── TLS et domaine ──
# Rien à saisir : Coolify publie le service « web » derrière son proxy et
# renouvelle le certificat Let's Encrypt. Le domaine se déclare sur la
# fiche du service, pas ici.
