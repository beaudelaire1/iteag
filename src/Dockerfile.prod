# ═══════════════════════════════════════════════════
# ITEAG — Dockerfile Production (multi-stage)
# Standard Trait d'Union Studio
# Voir docs/architecture/adr/ADR-004-pipeline-assets-production.md
# ═══════════════════════════════════════════════════

# ── Étape 1 : feuilles de style et bibliothèques tierces ──
# Tailwind 4 balaie les templates pour déterminer les classes réellement
# utilisées : sans eux, la feuille produite serait amputée.
# Les bibliothèques tierces (hls.js) sont copiées depuis node_modules et
# servies depuis notre origine — jamais depuis un CDN (ADR-005).
FROM node:22-alpine AS assets

WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund

COPY assets/ assets/
COPY static/ static/
COPY templates/ templates/
COPY scripts/ scripts/
RUN npm run build \
    && test -s static/css/main.css \
    && test -s static/js/vendor/hls.min.js

# ── Étape 2 : dépendances Python ──
FROM python:3.12-slim AS deps

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/base.txt requirements/base.txt
COPY requirements/prod.txt requirements/prod.txt
RUN pip install --no-cache-dir -r requirements/prod.txt

# ── Étape 3 : image d'exécution ──
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libjpeg62-turbo \
    libffi8 \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    curl \
    # Polices des documents PDF. Sans elles, WeasyPrint retombe sur un
    # substitut arbitraire : les relevés et attestations imprimés ne
    # ressemblent alors pas à ce qui a été validé. EB Garamond porte les
    # titres, Liberation le corps et les tableaux.
    fonts-ebgaramond \
    fonts-liberation2 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system iteag && adduser --system --ingroup iteag iteag

WORKDIR /app

COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY . .

# Feuille de style compilée à l'étape 1 (jamais commitée : elle est reproductible)
COPY --from=assets /app/static/css/main.css static/css/main.css
COPY --from=assets /app/static/js/vendor/ static/js/vendor/

# Collecte des statiques — sans masquage d'erreur : un échec ici doit arrêter
# le build, pas produire une image qui servira un site sans style.
RUN DJANGO_SECRET_KEY=collectstatic-build-only-not-for-runtime \
    DJANGO_ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput --clear

RUN chown -R iteag:iteag /app

USER iteag

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f -H "X-Forwarded-Proto: https" http://localhost:8000/healthz || exit 1

CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
